COMPOSE_PROJECT_NAME=n8nlocal

TZ=America/New_York
GENERIC_TIMEZONE=America/New_York

# n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http

# IMPORTANT: set once and keep forever (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Execution retention (keeps DB from growing forever)
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none

# Optional heavy tuning
# NODE_OPTIONS=--max-old-space-size=4096

# Optional AI
OLLAMA_PORT=11434

# --- Logging / Dev clarity ---
N8N_LOG_LEVEL=debug
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# --- Binary / File handling (IMPORTANT for AI workflows) ---
N8N_BINARY_DATA_MODE=filesystem
N8N_BINARY_DATA_STORAGE_PATH=/files

# --- Payload limits (AI responses get big fast) ---
N8N_PAYLOAD_SIZE_MAX=32mb