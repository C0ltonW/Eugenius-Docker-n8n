# --- Required --- #

# PostgreSQL password (required)
POSTGRES_PASSWORD=change_me

# Encryption key – DO NOT change after first startup
N8N_ENCRYPTION_KEY=change_me

# --- n8n --- #
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Database --- #
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PORT=5432

# --- Ollama (Local LLM) --- #

# Default model to pull on first startup
OLLAMA_DEFAULT_MODEL=llama3

# Base URL used by n8n (do not change unless overriding)
OLLAMA_BASE_URL=http://ollama:11434

# Exposed port on host
OLLAMA_PORT=11434

# --- Optional / Advanced --- #
# Timezone
TZ=America/New_York

# Log level
# N8N_LOG_LEVEL=info
